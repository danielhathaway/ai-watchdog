[Unit]
Description=Collect AI Watchdog off-host evidence and alert on silent endpoints
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/ai-watchdog/off-host-collector.json

[Service]
User=ai-watchdog
Group=ai-watchdog
WorkingDirectory=/opt/ai-watchdog
ExecStart=/usr/bin/python3 -B -m watchdog off-host serve --settings /etc/ai-watchdog/off-host-collector.json
Restart=on-failure
RestartSec=5s
StateDirectory=ai-watchdog-collector
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
