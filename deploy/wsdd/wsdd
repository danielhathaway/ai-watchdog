#!/usr/bin/python3 -I
"""Local Wi-Fi discovery policy for the distribution's wsdd executable."""
import runpy
import socket
import sys
from pathlib import Path

WIFI = "__WIFI_INTERFACE__"
module = runpy.run_path(str(Path(__file__).with_name("wsdd.distrib")), run_name="_packaged_wsdd")
main = module["main"]
state = main.__globals__
original_parse = state["parse_args"]
original_socket = socket.socket


class DiscoverySocket(original_socket):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        if (self.family in (socket.AF_INET, socket.AF_INET6)
                and self.type in (socket.SOCK_DGRAM, socket.SOCK_STREAM)):
            try:
                self.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, WIFI.encode() + b"\0")
            except OSError:
                self.close()
                raise


def configure():
    original_parse()
    if state["args"].discovery:
        state["args"].interface = [WIFI]
        socket.socket = DiscoverySocket


state["parse_args"] = configure
sys.exit(main())
