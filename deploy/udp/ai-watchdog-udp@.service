[Unit]
Description=AI Watchdog UDP byte counters for UID %i
ConditionPathExists=/sys/kernel/btf/vmlinux

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
ExecStart=/usr/bin/python3 -I -B /opt/ai-watchdog-udp/collector.py %i
Restart=on-failure
RestartSec=10s
RuntimeDirectory=ai-watchdog-udp-%i
RuntimeDirectoryMode=0711
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH CAP_CHOWN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
