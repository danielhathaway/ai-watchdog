// SPDX-License-Identifier: GPL-2.0-only
// Count payload bytes at the IPv4 and IPv6 socket layer, including mmsg calls.
config = {
  max_map_keys = 2048;
  print_maps_on_exit = false;
}

fexit:inet_sendmsg,fexit:inet6_sendmsg
/uid == $1 && retval > 0 && args.sock->sk->sk_protocol == 17/
{
  if (((uint64)nsecs(monotonic) / 5000000000) % 2 == 0) {
    @even[((uint64)pid << 2) | 1] = sum((uint64)retval);
    @even[((uint64)pid << 2) | 3] = sum((uint64)1);
  } else {
    @odd[((uint64)pid << 2) | 1] = sum((uint64)retval);
    @odd[((uint64)pid << 2) | 3] = sum((uint64)1);
  }
}

fexit:inet_recvmsg,fexit:inet6_recvmsg
/uid == $1 && retval > 0 && !(args.flags & 0x2002) && args.sock->sk->sk_protocol == 17/
{
  if (((uint64)nsecs(monotonic) / 5000000000) % 2 == 0) {
    @even[(uint64)pid << 2] = sum((uint64)retval);
    @even[((uint64)pid << 2) | 2] = sum((uint64)1);
  } else {
    @odd[(uint64)pid << 2] = sum((uint64)retval);
    @odd[((uint64)pid << 2) | 2] = sum((uint64)1);
  }
}

// Print the completed bucket while packet accounting writes to the other map.
interval:s:1
{
  $epoch = (uint64)nsecs(monotonic) / 5000000000;
  if ($epoch != @last_epoch) {
    @last_epoch = $epoch;
    if ($epoch % 2 == 0) {
      @odd[(uint64)0] = sum($epoch);
      print(@odd);
      clear(@odd);
    } else {
      @even[(uint64)0] = sum($epoch);
      print(@even);
      clear(@even);
    }
  }
}
