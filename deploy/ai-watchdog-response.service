[Unit]
Description=AI Watchdog independent containment supervisor
Wants=ai-watchdog.service
After=ai-watchdog.service nftables.service firewalld.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90s
User=root
Group=ai-watchdog
WorkingDirectory=/opt/ai-watchdog
ExecStart=/usr/bin/python3 -B -m watchdog supervise
Restart=always
RestartSec=2s
RuntimeDirectory=ai-watchdog-response
RuntimeDirectoryMode=0755
StateDirectory=ai-watchdog-response
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes

[Install]
WantedBy=multi-user.target
